    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pik Blink utilitza la teva ubicació per recordar-te un Pik quan arribis o surtis d'un lloc que hagis escollit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pik Blink uses your location to remind you about a Pik when you arrive at or leave a place you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pik Blink utiliza tu ubicación para recordarte un Pik cuando llegues o salgas de un lugar que hayas elegido."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pik Blink utilitza la teva ubicació per recordar-te tasques quan arribis a un lloc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pik Blink uses your location to remind you of tasks when you arrive at a place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pik Blink utiliza tu ubicación para recordarte tareas al llegar a un lugar."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pik Blink utilitza el micròfon per gravar les teves notes de veu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pik Blink uses the microphone to record your voice notes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pik Blink usa el micrófono para grabar tus notas de voz."
