    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Necessitem accés permanent per avisar-te fins i tot amb l'app tancada."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need permanent access to alert you even when the app is closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Necesitamos acceso permanente para avisarte incluso con la app cerrada."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pik Blink utilitza la teva ubicació per recordar-te tasques quan arribis a un lloc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pik Blink uses your location to remind you of tasks when you arrive at a place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pik Blink utiliza tu ubicación para recordarte tareas al llegar a un lugar."
          }
        }
      }
    },
