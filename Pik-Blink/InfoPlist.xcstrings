    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pik Blink utilitza el reconeixement de veu per convertir la teva veu en text quan creïs un nou Pik."
