    "new.item.popup.close.description" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si tanques aquesta finestra, es perdran els canvis que no s'han desat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you close this window, your unsaved changes will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si cierras esta ventana, se perderán los cambios no guardados."
          }
